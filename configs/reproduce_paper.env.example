# Copy this file to a private location and edit the paths before running.

MODEL_NAME_OR_PATH=/path/to/Qwen2.5-VL-7B-Instruct
PUBMED_KNOWLEDGE_JSONL=/path/to/pubmed_cervical_knowledge.jsonl
OUTPUT_ROOT=outputs/reproduce
BASELINE_CONFIG=configs/baselines.json.example

DST_ANNOTATIONS=/path/to/dst_annotations.jsonl
DST_IMAGE_ROOT=/path/to/dst/images

COMPARISON_ANNOTATIONS=/path/to/comparison_detector_annotations.jsonl
COMPARISON_IMAGE_ROOT=/path/to/comparison_detector/images

HICERVIX_ANNOTATIONS=/path/to/hicervix_annotations.jsonl
HICERVIX_IMAGE_ROOT=/path/to/hicervix/images

TRAIN_DATASET_JSONL=outputs/reproduce/DST_cervicot.jsonl
SFT_OUTPUT_DIR=outputs/reproduce/checkpoints/sft
GRPO_OUTPUT_DIR=outputs/reproduce/checkpoints/grpo
EVAL_MODEL=outputs/reproduce/checkpoints/grpo

NPROC_PER_NODE=4
USE_DEEPSPEED=1
DST_TEST_RATIO=0.2
FEWSHOT_TEST_RATIO=0.9
HICERVIX_RESIZE_FULL_IMAGE=0
SEED=42
RAG_TOP_K=3
CERVICOT_GENERATOR_CMD=
CERVICOT_USE_FALLBACK_TEMPLATE=0
DVHR_AUX_BATCH_SIZE=4
RUN_TRAINING=1
RUN_EVAL=1
RUN_BASELINES=0
